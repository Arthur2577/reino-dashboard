generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model guild_settings {
  guild_id                String  @id @db.VarChar(30)
  conflict_log_channel_id String? @db.VarChar(30)
}

model realms {
  user_id               String  @id @db.VarChar(30)
  gold                  BigInt? @default(100)
  safe_vault            BigInt? @default(0)
  wall_level            Int?    @default(1)
  army_power            Int?    @default(10)
  shield_until          BigInt? @default(0)
  work_cooldown_until   BigInt? @default(0)
  vault_level           Int?    @default(1)
  attack_cooldown_until BigInt? @default(0)
  protection_until      BigInt? @default(0)
}

model users {
  user_id       String    @id @db.VarChar(30)
  username      String    @db.VarChar(255)
  avatar        String?   @db.VarChar(255)
  discriminator String?   @db.VarChar(10)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}